# ==========================================
# WEATHERDATA PLATFORM - ENVIRONMENT CONFIG
# ==========================================

# Database Configuration (SQL Server)
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=WeatherDataWarehouse
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
# DB_USER=sa
# DB_PASSWORD=YourPassword

# Weather API Configuration
# Options: 'weatherapi' (requires key) or 'openmeteo' (keyless)
WEATHER_API_PROVIDER=weatherapi
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_API_BASE_URL=http://api.weatherapi.com/v1/current.json
WEATHER_API_TIMEOUT_SECONDS=10

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
