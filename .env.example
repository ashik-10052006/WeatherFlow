# ==========================================
# WEATHERDATA PLATFORM - ENVIRONMENT CONFIG
# ==========================================

# Database Configuration (SQL Server)
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=WeatherDataWarehouse
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
# If using SQL Authentication instead of Windows Authentication, uncomment and set:
# DB_USER=sa
# DB_PASSWORD=YourStrongPasswordHere

# Weather API Configuration (Open-Meteo REST API)
# Note: Open-Meteo does not require an API key
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_SECONDS=10

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
